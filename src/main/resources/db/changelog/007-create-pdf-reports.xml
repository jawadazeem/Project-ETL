<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="007-create-pdf-reports" author="jawad">
        <createTable tableName="pdf_reports">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="dataset_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="billing_period" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="s3_object_key" type="varchar(1024)">
                <constraints nullable="false"/>
            </column>
            <column name="file_size_bytes" type="bigint"/>
            <column name="generated_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="pdf_reports"
            baseColumnNames="dataset_id"
            constraintName="fk_pdf_reports_dataset"
            referencedTableName="datasets"
            referencedColumnNames="id"
            onDelete="CASCADE"/>

        <addForeignKeyConstraint
            baseTableName="pdf_reports"
            baseColumnNames="user_id"
            constraintName="fk_pdf_reports_user"
            referencedTableName="app_users"
            referencedColumnNames="id"
            onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
