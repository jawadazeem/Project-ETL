<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-create-datasets" author="jawad">
        <createTable tableName="datasets">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="owner_user_id" type="uuid"/>
            <column name="billing_period" type="varchar(20)"/>
            <column name="source_filename" type="varchar(500)"/>
            <column name="s3_object_key" type="varchar(1024)"/>
            <column name="uploaded_at" type="timestamptz"/>
            <column name="status" type="varchar(50)"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="datasets"
            baseColumnNames="owner_user_id"
            constraintName="fk_datasets_owner_user"
            referencedTableName="app_users"
            referencedColumnNames="id"
            onDelete="SET NULL"/>
    </changeSet>

</databaseChangeLog>
