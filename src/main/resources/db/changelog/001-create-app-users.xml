<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-app-users" author="jawad">
        <createTable tableName="app_users">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="provider" type="varchar(100)"/>
            <column name="provider_subject" type="varchar(255)">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uq_app_users_provider_subject"/>
            </column>
            <column name="email" type="varchar(255)"/>
            <column name="display_name" type="varchar(255)"/>
            <column name="picture_url" type="varchar(1024)"/>
            <column name="role" type="varchar(50)"/>
            <column name="created_at" type="timestamptz"/>
            <column name="last_login_at" type="timestamptz"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
